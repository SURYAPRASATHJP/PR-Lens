# Copy to .env for local work. Never commit the filled-in version.
# These names are used verbatim by the host and by Actions, so do not rename them.

# ---------------------------------------------------------------------------
# The receiver needs exactly these two, and nothing else. If you find yourself
# adding a third, check first whether the work belongs in an Actions job instead.
# ---------------------------------------------------------------------------

# Shared with the GitHub App so we can prove a delivery really came from GitHub.
GH_WEBHOOK_SECRET=

# Fine-grained PAT, scoped to this repository alone, Contents: write. This is what
# fires repository_dispatch. It is deliberately NOT the App's token: the App stays
# Contents: read-only so "never pushes to your repo" is true at the token level.
# Fine-grained PATs expire, 90 days by default, and dispatch fails loudly when it does.
GH_DISPATCH_TOKEN=

# ---------------------------------------------------------------------------
# Actions secrets. The receiver never sees these and must never need them.
# ---------------------------------------------------------------------------

# Neon pooled connection string. The host contains "-pooler".
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# For posting comments as the App, from Phase 4 onward.
GH_APP_ID=
GH_APP_PRIVATE_KEY=

# Write access to the private dataset repo holding the corpus text. Fine-grained,
# scoped to that one dataset repo, read + write contents. The mining job fails loudly
# without it rather than reporting success having uploaded nothing.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Optional overrides.
# ---------------------------------------------------------------------------

# The mining job's own credential, if you would rather not point the dispatch token
# at 27 other people's repositories. Falls back to GH_DISPATCH_TOKEN when unset.
# It must be able to READ public repositories: a fine-grained PAT restricted to
# selected repositories passes the rate-limit check and then 404s on every repo it
# does not own, which the job's preflight catches at startup.
#
# Never the workflow's built-in GITHUB_TOKEN. That is 1,000 requests per hour PER
# REPOSITORY against 5,000 for a PAT, and the client refuses it rather than mining
# at a fifth of the speed.
# GH_MINING_TOKEN=

# The repositories to mine, as a comma-separated list or the mining-set JSON. Passed
# in rather than stored, so the workspace notes it comes from stay out of this repo.
# MINING_REPOS=celery/celery,aio-libs/aiohttp

# DISPATCH_REPO=SURYAPRASATHJP/pr-lens
# DISPATCH_EVENT_TYPE=pr_event
# LOG_LEVEL=INFO
