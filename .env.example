# Copy to .env for local work. Never commit the filled-in version.
# The same names are used as Actions secrets and Space secrets, so do not rename them.

# Shared with the GitHub App so we can verify that a delivery really came from GitHub.
GH_WEBHOOK_SECRET=

# Fine-grained PAT, scoped to this repository alone, Contents: write.
# This is what fires repository_dispatch. It is deliberately NOT the App's token: the App
# stays Contents: read-only so "never pushes to your repo" is true at the token level.
# Fine-grained PATs expire, 90 days by default. Dispatch fails loudly when it lapses.
GH_DISPATCH_TOKEN=

# Neon pooled connection string. The host contains "-pooler".
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Needed from Phase 4, when we start posting comments. The Space boots without them.
GH_APP_ID=
GH_APP_PRIVATE_KEY=

# Optional overrides.
# DISPATCH_REPO=SURYAPRASATHJP/pr-lens
# DISPATCH_EVENT_TYPE=pr_event
# LOG_LEVEL=INFO
